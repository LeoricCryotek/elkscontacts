<odoo>
  <!-- Legacy "Elks: officer-position dropdown" form row removed.
       Officer positions are driven by the Officer Terms model, which
       auto-syncs x_elks_officer_position onto the contact record. -->

  <!-- ============================================================
       Standalone Officer Term views (for menu access)
       ============================================================ -->

  <record id="view_elks_officer_term_list" model="ir.ui.view">
    <field name="name">elks.officer.term.list</field>
    <field name="model">elks.officer.term</field>
    <field name="arch" type="xml">
      <list decoration-muted="not active or x_is_vacated"
            decoration-danger="x_is_vacated">
        <field name="active" column_invisible="1"/>
        <field name="lodge_year"/>
        <field name="position"/>
        <field name="partner_id"/>
        <field name="officer_type"/>
        <field name="partial_year"/>
        <field name="date_start" optional="show"/>
        <field name="date_end" optional="show"/>
        <field name="x_is_vacated" string="Vacant" optional="show"/>
        <field name="x_vacated_date" string="Vacated On" optional="hide"/>
        <field name="x_vacated_reason" string="Vacate Reason" optional="hide"/>
        <field name="gender" optional="hide"/>
        <field name="show_on_website" optional="hide"/>
        <field name="message" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_elks_officer_term_form" model="ir.ui.view">
    <field name="name">elks.officer.term.form</field>
    <field name="model">elks.officer.term</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <!--
              Mid-term vacancy actions. Two mutually-exclusive buttons:
              "Mark Officer Vacated" (visible while filled) and
              "Fill Vacant Position" (visible once vacated). This is the
              only supported workflow for retiring/resigning an officer
              mid-term — deleting the record would lose the historical
              audit of who held the seat.
          -->
          <button name="action_open_vacate_wizard"
                  string="Mark Officer Vacated"
                  type="object"
                  class="btn-danger"
                  invisible="x_is_vacated"/>
          <button name="action_open_fill_vacant_position"
                  string="Fill Vacant Position"
                  type="object"
                  class="btn-primary"
                  invisible="not x_is_vacated"/>
          <field name="x_is_vacated" invisible="1"/>
        </header>
        <sheet>
          <!-- Vacant ribbon so it's obvious at a glance that this
               officer seat is currently displayed as Vacant. -->
          <widget name="web_ribbon" title="Vacant"
                  bg_color="text-bg-danger"
                  invisible="not x_is_vacated"/>
          <div class="oe_button_box" name="button_box"/>
          <field name="image_1920" widget="image" class="oe_avatar"
                 options="{'preview_image': 'image_1920'}"/>
          <div class="oe_title">
            <h1><field name="display_name"/></h1>
          </div>
          <group>
            <group string="Position Details">
              <field name="partner_id"/>
              <field name="position"/>
              <field name="officer_type"/>
              <field name="lodge_year"/>
              <field name="partial_year"/>
              <field name="date_start"/>
              <field name="date_end"/>
              <field name="gender"/>
            </group>
            <group string="Website Display">
              <field name="officer_email" widget="email"/>
              <field name="officer_phone" widget="phone"/>
              <field name="show_on_website"/>
            </group>
          </group>
          <!-- Vacancy details — only rendered once the wizard has
               stamped the term. Left editable so the Secretary can
               correct the reason or date without going through a
               reset-and-redo. -->
          <group string="Vacancy Details"
                 invisible="not x_is_vacated">
            <group>
              <field name="x_vacated_date"/>
              <field name="x_vacated_reason"/>
            </group>
            <group>
              <field name="x_vacated_notes"
                     placeholder="Optional detail..."/>
            </group>
          </group>
          <separator string="Public Message"/>
          <field name="message" nolabel="1"
                 placeholder="Write a public bio or message for the website..."/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_elks_officer_term_search" model="ir.ui.view">
    <field name="name">elks.officer.term.search</field>
    <field name="model">elks.officer.term</field>
    <field name="arch" type="xml">
      <search>
        <field name="partner_id"/>
        <field name="position"/>
        <field name="lodge_year"/>
        <separator/>
        <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
        <filter name="filter_archived" string="Archived"
                domain="[('active', '=', False)]"/>
        <filter name="filter_partial" string="Partial Year"
                domain="[('partial_year', '=', True)]"/>
        <filter name="filter_vacant" string="Vacant Seats"
                domain="[('x_is_vacated', '=', True)]"/>
        <filter name="filter_filled" string="Filled Seats"
                domain="[('x_is_vacated', '=', False)]"/>
        <separator/>
        <filter name="group_year" string="Lodge Year" context="{'group_by': 'lodge_year'}"/>
        <filter name="group_position" string="Position" context="{'group_by': 'position'}"/>
        <filter name="group_type" string="Officer Type" context="{'group_by': 'officer_type'}"/>
      </search>
    </field>
  </record>

  <!-- Action to open Officer Terms -->
  <record id="action_elks_officer_terms" model="ir.actions.act_window">
    <field name="name">Officer Terms</field>
    <field name="res_model">elks.officer.term</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        No officer terms recorded yet.
      </p>
      <p>
        Track which members hold officer positions each lodge year.
      </p>
    </field>
  </record>

</odoo>
